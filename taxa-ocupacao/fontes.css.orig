@font-face {
  font-family: 'PT Serif';
  font-style: normal;
  font-weight: 700;
  src: local('PT Serif Bold'), local('PTSerif-Bold'),
       url(/static/font/pt-serif/pt-serif-v10-latin_latin-ext-700.woff2) format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
       url(/static/font/pt-serif/pt-serif-v10-latin_latin-ext-700.woff) format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
}

/* pt-serif-700italic - latin_latin-ext */
@font-face {
  font-family: 'PT Serif';
  font-style: italic;
  font-weight: 700;
  src: local('PT Serif Bold Italic'), local('PTSerif-BoldItalic'),
       url(/static/font/pt-serif/pt-serif-v10-latin_latin-ext-700italic.woff2) format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
       url(/static/font/pt-serif/pt-serif-v10-latin_latin-ext-700italic.woff) format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
}

.material-font {
  font-family: 'Material Icons';
  font-style: normal;
}

