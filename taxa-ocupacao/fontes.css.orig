@font-face {
  font-family: 'Material Icons';
  font-style: normal;
  font-weight: 400;
  src: url(/static/font/material-icons/md-icons-4.0.0.eot); /* For IE6-8 */
  /*src: url(/static/font/material-icons/MaterialIcons-Regular.eot);*/
  src: local('Material Icons'),
       local('MaterialIcons-Regular'),
       /*url(/static/font/material-icons/MaterialIcons-Regular.woff2) format('woff2'),
       url(/static/font/material-icons/MaterialIcons-Regular.woff) format('woff'),
       url(/static/font/material-icons/MaterialIcons-Regular.ttf) format('truetype');*/
       url(/static/font/material-icons/md-icons-4.0.0.woff2) format('woff2'),
       url(/static/font/material-icons/md-icons-4.0.0.woff) format('woff'),
       url(/static/font/material-icons/md-icons-4.0.0.ttf) format('truetype');
}
