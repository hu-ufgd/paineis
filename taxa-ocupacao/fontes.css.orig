/* roboto-100 - latin */
@font-face {
  font-family: 'Roboto';
  font-style: normal;
  font-weight: 100;
  src: url('/static/font/roboto/roboto-v15-latin-100.eot'); /* IE9 Compat Modes */
  src: local('Roboto Thin'), local('Roboto-Thin'),
       url('/static/font/roboto/roboto-v15-latin-100.eot?#iefix') format('embedded-opentype'), /* IE6-IE8 */
       url('/static/font/roboto/roboto-v15-latin-100.woff2') format('woff2'), /* Super Modern Browsers */
       url('/static/font/roboto/roboto-v15-latin-100.woff') format('woff'), /* Modern Browsers */
       url('/static/font/roboto/roboto-v15-latin-100.ttf') format('truetype'), /* Safari, Android, iOS */
       url('/static/font/roboto/roboto-v15-latin-100.svg#Roboto') format('svg'); /* Legacy iOS */
}
/* roboto-100italic - latin */
@font-face {
  font-family: 'Roboto';
  font-style: italic;
  font-weight: 100;
  src: url('/static/font/roboto/roboto-v15-latin-100italic.eot'); /* IE9 Compat Modes */
  src: local('Roboto Thin Italic'), local('Roboto-ThinItalic'),
       url('/static/font/roboto/roboto-v15-latin-100italic.eot?#iefix') format('embedded-opentype'), /* IE6-IE8 */
       url('/static/font/roboto/roboto-v15-latin-100italic.woff2') format('woff2'), /* Super Modern Browsers */
       url('/static/font/roboto/roboto-v15-latin-100italic.woff') format('woff'), /* Modern Browsers */
       url('/static/font/roboto/roboto-v15-latin-100italic.ttf') format('truetype'), /* Safari, Android, iOS */
       url('/static/font/roboto/roboto-v15-latin-100italic.svg#Roboto') format('svg'); /* Legacy iOS */
}
