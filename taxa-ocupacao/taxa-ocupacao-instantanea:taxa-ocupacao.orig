        <script src="/base/assets/js/TabelaAjax.js" type="text/javascript"></script>
        <script src="/base/assets/js/base.js"></script>

        <script type="text/javascript">
            var timeOutBusca = null;
            var trocarMenus = true;
            var beforeFetch = false;
            var beforeResponse = false;

            const {fetch: origFetch} = window;
            
            window.fetch = async (...args) => {
                if(beforeFetch){
                    beforeFetch();
                }
                console.log("fetch called with args:", args);
                const response = await origFetch(...args);
                
                /* work with the cloned response in a separate promise
                    chain -- could use the same chain with `await`. */
                response
                    .clone()
                    .json()
                    .then(body => console.log("intercepted response:", body))
                    .catch(err => console.error(err))
                ;
                    
                
                if(beforeResponse){
                    beforeResponse(response);
                }
                /* the original response can be resolved unmodified: */
                return response;
                
                /* or mock the response: * /
                return {
                    ok: true,
                    status: 200,
                    json: async () => ({
                    userId: 1,
                    id: 1,
                    title: "Mocked!!",
                    completed: false
                    })
                }; */
            };

            $.ajaxSetup({'global': true});
            $(document).ready(function () {
                $("body").on('click', '.bt-excluir', function (e) {
                    if (!confirm("Deseja realmente excluir esse registro?")) {
                        e.preventDefault();
                    }
                });

                seletor = "a[href='" + document.location.pathname + "']";
                $(seletor).closest("li").addClass("active"); //closest = sobe na arvore; find = desce na arvore
                $(seletor).closest(".collapsible-body").css({
                    "display": "block"
                });

            });
        </script>
         
    </body>
